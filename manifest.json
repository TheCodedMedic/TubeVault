{
  "manifest_version": 3,
  "name": "TubeVault",
  "version": "1.6.3",
  "description": "Save YouTube channels into niche folders. Click + on any channel or video to save the channel.",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open TubeVault",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared/store.js",
        "shared/warm.js",
        "sidepanel/detect.js",
        "content/content.js",
        "content/tracker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "sidepanel/detect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Ufuoma Oboh"
}
